# =============================================================================
# VINEA - Configuração de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no Git!

# =============================================================================
# MNI TJSP - E-SAJ (Sistema Tradicional)
# =============================================================================
TJSPMNIUSUARIO=seu_usuario_esaj
TJSPMNISENHA=sua_senha_esaj
TJSP_MNI_WSDL=http://esaj.tjsp.jus.br/mniws/servico-intercomunicacao-2.2.2/intercomunicacao?wsdl

# =============================================================================
# E-Proc - Sistema Eletrônico de Processos (1G e 2G)
# =============================================================================
# Usuário E-Proc (geralmente fornecido pelo TJSP)
EPROC_USUARIO=CAO_CAEx_Consulta_MP

# Segredo para geração de senha SHA-256
# A senha é gerada automaticamente como: SHA256(DD-MM-AAAA + EPROC_PASSWORD_SECRET)
# IMPORTANTE: Mantenha este valor em SEGREDO!
EPROC_PASSWORD_SECRET=seu_segredo_eproc_aqui

# E-Proc 1G (1ª Instância) - WSDLs
EPROC_1G_WSDL_2_2=https://eproc1gws.tjsp.jus.br/eproc/wsdl.php?srv=intercomunicacaoUnificada2.2
EPROC_1G_WSDL_3_0=https://eproc1gws.tjsp.jus.br/eproc/wsdl.php?srv=intercomunicacaoUnificada3.0

# E-Proc 2G (2ª Instância) - WSDL
EPROC_2G_WSDL=https://eproc2g.tjsp.jus.br/eproc/ws/intercomunicacao2.2/wsdl/servico-intercomunicacao-2.2.2.wsdl

# =============================================================================
# Azure OpenAI - Para extração de MPUs
# =============================================================================
AZURE_OPENAI_API_KEY=sua_chave_azure
AZURE_OPENAI_RESOURCE=seu_resource_name
AZURE_OPENAI_IMPLEMENTACAO=nome_do_deployment
AZURE_OPENAI_VERSAO_API=2024-02-01

# =============================================================================
# SQL Server - Banco de dados (opcional)
# =============================================================================
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=nome_do_banco
SQL_SERVER_USERNAME=usuario
SQL_SERVER_PASSWORD=senha
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server

# =============================================================================
# PySpark - Configuração (opcional)
# =============================================================================
# PYSPARK_PYTHON=/caminho/para/.venv/bin/python3
# PYSPARK_DRIVER_PYTHON=/caminho/para/.venv/bin/python3

# =============================================================================
# Logging e API
# =============================================================================
LOG_LEVEL=INFO
API_TIMEOUT=30
MAX_RETRIES=3
